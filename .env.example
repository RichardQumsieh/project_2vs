# Repo-root Compose interpolation (docker-compose.prod.yml).
# Copy to `.env` on the VM and fill secrets there — never commit real values.
# Compose reads this file automatically for ${VAR} substitution.
#
# API-only (postgres + redis + backend): set the three keys below.
# NEXT_PUBLIC_API_URL is optional for backend-only build/up (has a prod default).

JWT_SECRET=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters
FRONTEND_ORIGIN=https://sophia.apps.grok.bot

# Forced true in docker-compose.prod.yml; listed here for operators who also
# export vars in the shell. Do not set false in prod.
COOKIE_SECURE=true

# Reverse proxies allowed to set X-Forwarded-For and X-Forwarded-Proto.
# Leave empty to ignore forwarded headers (correct for local Compose, and the
# safe default). Production example: TRUST_PROXY=10.0.0.0/8
# Never set true. The API rejects that value.
TRUST_PROXY=

# Only required when building/starting the frontend image on this host.
# NEXT_PUBLIC_API_URL=https://api.sophia-build.com

# Provider writes. Production Compose defaults the flag to false.
# To dogfood one account, set true and list that user's id, username, or email.
# The allowlist does not enable writes while the flag is false.
INTEGRATIONS_WRITE_ENABLED=false
INTEGRATIONS_WRITE_ALLOWLIST=

# Cloud Sophia. Leave empty until you want hosted-model calls.
# The API returns 503 and does not invent a reply when the key or base URL is unset.
# SOPHIA_MODEL_BASE_URL=https://api.x.ai/v1
# SOPHIA_MODEL_NAME=grok-4
SOPHIA_MODEL_API_KEY=
SOPHIA_MODEL_BASE_URL=
SOPHIA_MODEL_NAME=

# Small-group MLS. Leave false until you want /conversations/group.
# The web client also needs NEXT_PUBLIC_GROUP_E2EE_ENABLED=true.
GROUP_E2EE_ENABLED=false

# Adaptive appearance (colors, backgrounds, draft voice). The web client reads
# NEXT_PUBLIC_ADAPTIVE_THEME_ENABLED. Leave it unset or false in production.
# Turning it on does not upload chat text or theme images.
NEXT_PUBLIC_ADAPTIVE_THEME_ENABLED=false

# Safety numbers and key-change warnings. Both flags must be true.
# The API flag is SAFETY_NUMBERS_ENABLED. The web client reads
# NEXT_PUBLIC_SAFETY_NUMBERS_ENABLED when Next starts or when the image is built.
# Leave both false in production until you want Settings → Security to show them.
# No database migration. See docs/safety-numbers.md.
SAFETY_NUMBERS_ENABLED=false
NEXT_PUBLIC_SAFETY_NUMBERS_ENABLED=false
