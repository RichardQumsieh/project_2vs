# Repo-root Compose interpolation (docker-compose.prod.yml).
# Copy to `.env` on the VM and fill secrets there — never commit real values.
# Compose reads this file automatically for ${VAR} substitution.
#
# API-only (postgres + redis + backend): set the three keys below.
# NEXT_PUBLIC_API_URL is optional for backend-only build/up (has a prod default).

JWT_SECRET=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters
FRONTEND_ORIGIN=https://sophia.apps.grok.bot

# Forced true in docker-compose.prod.yml; listed here for operators who also
# export vars in the shell. Do not set false in prod.
COOKIE_SECURE=true

# Reverse proxies allowed to set X-Forwarded-For and X-Forwarded-Proto.
# Leave empty to ignore forwarded headers (correct for local Compose, and the
# safe default). Production example: TRUST_PROXY=10.0.0.0/8
# Never set true. The API rejects that value.
TRUST_PROXY=

# Only required when building/starting the frontend image on this host.
# NEXT_PUBLIC_API_URL=https://api.sophia-build.com

# Provider writes. Production Compose defaults the flag to false.
# To dogfood one account, set true and list that user's id, username, or email.
# The allowlist does not enable writes while the flag is false.
INTEGRATIONS_WRITE_ENABLED=false
INTEGRATIONS_WRITE_ALLOWLIST=

# Cloud Sophia. Leave empty until you want hosted-model calls.
# The API returns 503 and does not invent a reply when the key or base URL is unset.
# SOPHIA_MODEL_BASE_URL=https://api.x.ai/v1
# SOPHIA_MODEL_NAME=grok-4
SOPHIA_MODEL_API_KEY=
SOPHIA_MODEL_BASE_URL=
SOPHIA_MODEL_NAME=
# Web push. Set all three or none. See docs/notifications.md.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Inbox agent. On unless exactly false. See docs/agent-control.md.
SOPHIA_AGENT_ENABLED=true

# Small-group MLS. On unless exactly false.
# The web client uses NEXT_PUBLIC_GROUP_E2EE_ENABLED the same way.
GROUP_E2EE_ENABLED=true

# Adaptive appearance (colors, backgrounds, draft voice). On unless exactly false.
# Turning it on does not upload chat text or theme images.
NEXT_PUBLIC_ADAPTIVE_THEME_ENABLED=true

# Workspace billing. Default off: no Stripe or PayPal call and no charge.
# Set BILLING_ENABLED=true and BILLING_PROVIDER=paypal (or stripe) only when the
# keys below exist. mock marks a checkout active in-process and is what tests use.
# PayPal is the provider for a Jordan business account. See docs/billing.md.
BILLING_ENABLED=false
BILLING_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_FAMILY_PLUS=
# STRIPE_PRICE_TEAM_SEAT=
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_PLAN_FAMILY_PLUS=
# PAYPAL_PLAN_TEAM_SEAT=

# Safety numbers and key-change warnings. On unless the value is exactly false.
# Unset, empty, and true leave the directory and Settings → Security available.
# SAFETY_NUMBERS_ENABLED is the API flag. The web client reads
# NEXT_PUBLIC_SAFETY_NUMBERS_ENABLED when Next starts or when the image is built.
# Restart or rebuild after changing the client flag. No database migration.
# See docs/safety-numbers.md.
SAFETY_NUMBERS_ENABLED=true
NEXT_PUBLIC_SAFETY_NUMBERS_ENABLED=true

# Manager daily brief. On unless the value is exactly false.
# Unset, empty, and true open the brief. Only false closes it.
# Mail and calendar writes stay behind INTEGRATIONS_WRITE_ENABLED.
# The web client reads NEXT_PUBLIC_DAILY_BRIEF_ENABLED when Next starts
# or when the image is built. Restart or rebuild after changing it.
# See docs/daily-brief.md.
DAILY_BRIEF_ENABLED=true
NEXT_PUBLIC_DAILY_BRIEF_ENABLED=true
