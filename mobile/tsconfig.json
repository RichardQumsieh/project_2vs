{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "ts-mls": ["./node_modules/ts-mls/dist/src/index.d.ts"],
      "ts-mls/*": ["./node_modules/ts-mls/dist/src/*"],
      "expo-sqlite": ["./node_modules/expo-sqlite/build/index.d.ts"],
      "expo-secure-store": ["./node_modules/expo-secure-store/build/SecureStore.d.ts"]
    },
    "moduleSuffixes": [".native", ""],
    "types": ["node", "react"]
