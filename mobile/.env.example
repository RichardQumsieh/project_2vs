# APIs and website origin (the website is only used for encrypted thread UI and
# connected-tool flows while native screens cover the rest of the product).
EXPO_PUBLIC_API_URL=https://api.sophia-build.com
EXPO_PUBLIC_SOPHIA_WEB_URL=https://sophia.apps.grok.bot

# TURN is configured on the API (TURN_URLS and TURN_SHARED_SECRET).
# The app only receives short-lived credentials from GET /calls/ice-servers.

# Android message and call push uses Firebase Cloud Messaging through EAS.
# Do not commit these files. See docs/notifications.md and docs/incoming-calls.md.
# - mobile/google-services.json (download from Firebase; gitignored)
# - FCM V1 service account key, uploaded with `eas credentials` (not an env var)
