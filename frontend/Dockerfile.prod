FROM node:22-alpine AS build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# Override at build time for custom domains; default matches published sophia.
ARG NEXT_PUBLIC_API_URL=https://api.sophia-build.com
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SAFETY_NUMBERS_ENABLED=true
ENV NEXT_PUBLIC_SAFETY_NUMBERS_ENABLED=$NEXT_PUBLIC_SAFETY_NUMBERS_ENABLED
# On unless the build arg is exactly false. Empty stays on.
ARG NEXT_PUBLIC_DAILY_BRIEF_ENABLED=true
ENV NEXT_PUBLIC_DAILY_BRIEF_ENABLED=$NEXT_PUBLIC_DAILY_BRIEF_ENABLED
# Groups and adaptive theme stay on unless the build arg is exactly false.
ARG NEXT_PUBLIC_GROUP_E2EE_ENABLED=true
ENV NEXT_PUBLIC_GROUP_E2EE_ENABLED=$NEXT_PUBLIC_GROUP_E2EE_ENABLED
ARG NEXT_PUBLIC_ADAPTIVE_THEME_ENABLED=true
ENV NEXT_PUBLIC_ADAPTIVE_THEME_ENABLED=$NEXT_PUBLIC_ADAPTIVE_THEME_ENABLED
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/.next ./.next

EXPOSE 3000
CMD ["npm", "run", "start", "--", "--hostname", "0.0.0.0"]
