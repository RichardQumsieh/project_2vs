DATABASE_URL="postgresql://messenger:messenger@127.0.0.1:55432/messenger"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="replace-with-at-least-32-random-characters"
TOTP_ENCRYPTION_KEY="replace-with-64-hex-characters"
PORT=3001
FRONTEND_ORIGIN="http://localhost:3000"
COOKIE_NAME="messenger_session"
# When true (production Compose default), session cookies use SameSite=None so
# cross-site credentialed fetch (SPA on another host) can send them. Requires HTTPS.
# NODE_ENV=production refuses to boot if this is false.
COOKIE_SECURE=false
# Comma-separated proxy IPs or CIDRs. Empty ignores X-Forwarded-*. Never set true.
TRUST_PROXY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# Phase 2 calendar OAuth (leave empty until clients are registered).
# Redirect URIs: {API_PUBLIC_ORIGIN}/integrations/calendar/google|outlook/callback
# Scopes (P4.2): Google calendar.events; Outlook Calendars.ReadWrite + offline_access + User.Read
API_PUBLIC_ORIGIN=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Per-user mail OAuth (separate from GMAIL_* recovery sender above).
# Redirect URIs: {API_PUBLIC_ORIGIN}/integrations/email/gmail|outlook-mail/callback
# Scopes (P4.2): Gmail readonly+compose; Outlook Mail.ReadWrite + offline_access + User.Read
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
# Phase 3 GitHub / Linear work OAuth (leave empty until clients are registered).
# Redirect URIs: {API_PUBLIC_ORIGIN}/integrations/work/github|linear/callback
# Scopes (P4.2): GitHub read:user+repo; Linear read+write
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
# Phase 3 Slack collab OAuth (leave empty until the Slack app is registered).
# Redirect URI: {API_PUBLIC_ORIGIN}/integrations/collab/slack/callback
# User scopes (P4.2): channels:read, groups:read, users:read, chat:write (no channels:history)
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
# Phase 4.2 owner-scoped write APIs (default off until provider consoles upgraded).
# When true: calendar event create/update, email draft, GitHub issue/comment,
# Linear issue, Slack chat.postMessage — still require already-approved payloads.
INTEGRATIONS_WRITE_ENABLED=false
BRAVE_SEARCH_API_KEY=
# Cloud Sophia (hosted model). Leave empty to keep the API on the local path.
# Both key and HTTPS base URL are required; if either is unset the route returns 503.
# Production Compose reads these from the repo-root .env, not from this file alone.
# SOPHIA_MODEL_BASE_URL example: https://api.x.ai/v1
# SOPHIA_MODEL_NAME defaults to grok-4 when empty.
SOPHIA_MODEL_API_KEY=
SOPHIA_MODEL_BASE_URL=
SOPHIA_MODEL_NAME=
SAFE_BROWSING_API_KEY=
TURN_URLS=
TURN_SHARED_SECRET=
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
