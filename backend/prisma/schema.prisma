generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

enum TaskStatus {
  OPEN
  DONE
  DISMISSED
}

enum TaskSource {
  MANUAL
  RADAR
}

enum ReminderStatus {
  SCHEDULED
  CANCELLED
  FIRED
}

enum AiConsentScope {
  CLOUD_AI
  CONVERSATION_ANALYSIS
}

enum IntegrationProvider {
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
  GMAIL
  OUTLOOK_MAIL
  GITHUB
  LINEAR
  SLACK
}

enum WorkItemKind {
  ISSUE
  PULL_REQUEST
}

enum IntegrationConnectionStatus {
  CONNECTED
  REVOKED
  ERROR
}

enum IntegrationWriteAction {
  SEND_EMAIL
  SAVE_DRAFT
  RESCHEDULE_EVENT
  DELETE_EVENT
}

enum IntegrationWriteStatus {
  PENDING
  EXECUTING
  SUCCEEDED
  FAILED
}

/// Actions the account activity log can store. Only a subset is written today.
/// MESSAGE_*, EMAIL_RECEIVED, and INTEGRATION_CONNECT are reserved and unused.
enum AccountActivityAction {
  LOGIN
  CLOUD_CONSENT_GRANTED
  CLOUD_CONSENT_WITHDRAWN
  SETTING_CHANGED
  EMAIL_SENT
  EMAIL_RECEIVED
  EMAIL_DRAFT_SAVED
  CALENDAR_DELETE_APPROVED
  CALENDAR_RESCHEDULE_APPROVED
  BUTTON_ACTION
  MESSAGE_SENT
  MESSAGE_RECEIVED
  INTEGRATION_CONNECT
  WORKSPACE_CREATED
  INVITE_CREATED
  INVITE_REVOKED
  INVITE_REDEEMED
  WORKSPACE_MEMBER_REMOVED
  WORKSPACE_ROLE_CHANGED
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  email              String    @unique
  passwordHash       String
  totpSecret         String?
  pendingTotpSecret  String?
  totpSetupExpiresAt DateTime?
  vaultVersion       Int       @default(1)

  displayName String?
  avatarUrl   String?
  interests   String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices              Device[]
  memberships          ConversationMember[]
  authSessions         AuthSession[]
  trustedBrowsers      TrustedBrowser[]
  authTokens           AuthToken[]
  recoveryCodes        RecoveryCode[]
  archiveKey           AccountArchiveKey?
  archiveMessages      AccountArchiveMessage[] @relation("ArchiveOwner")
  archivedSentMessages AccountArchiveMessage[] @relation("ArchiveSender")
  messageDeletions     MessageDeletion[]        @relation("MessageDeletionActor")
  projects             Project[]
  tasks                Task[]
  reminders            Reminder[]
  aiConsents           AiAuthorizationConsent[]
  cloudSophiaConsents  CloudSophiaConsent[]
  activityEvents       AccountActivityEvent[]
  integrations         IntegrationConnection[]
  calendarEvents       CalendarEventMirror[]
  mailMessages         MailMessageMirror[]
  workItems            WorkItemMirror[]
  collabChannels       CollabChannelMirror[]
  writeApprovals       IntegrationWriteApproval[]
  dailyBriefPreference DailyBriefPreference?
  dailyBriefs          DailyBrief[]
  workspaceMembers     WorkspaceMember[]
  invitesCreated       WorkspaceInvite[] @relation("InviteCreator")
  invitesRedeemed      WorkspaceInvite[] @relation("InviteRedeemer")

  @@index([interests], type: Gin)
}

model TrustedBrowser {
  id            String   @id @default(uuid())
  userId        String
  tokenHash     String   @unique
  networkPrefix String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthSession {
  id        String    @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model AuthToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Device {
  id         String @id @default(uuid())
  userId     String
  deviceName String

  identityPublicKey Bytes
  signingPublicKey  Bytes

  signedPreKeyId  Int
  signedPreKey    Bytes
  signedPreKeySig Bytes

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  oneTimePreKeys   OneTimePreKey[]
  sentMessages     Message[]
  receivedMessages Message[]       @relation("MessageRecipientDevice")
  backups          DeviceBackup[]
  groupMlsBlobsSent     GroupMlsBlob[] @relation("GroupMlsBlobSender")
  groupMlsBlobsReceived GroupMlsBlob[] @relation("GroupMlsBlobRecipient")

  @@index([userId])
}

model DeviceBackup {
  deviceId       String
  kind           String
  recordId       String
  conversationId String?
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, kind, recordId])
  @@index([deviceId, kind, recordId])
  @@index([deviceId, kind, conversationId])
}

model AccountArchiveKey {
  userId                      String   @id
  publicKey                   Bytes
  passwordSalt                Bytes
  passwordNonce               Bytes
  passwordEncryptedPrivateKey Bytes
  recoverySalt                Bytes
  recoveryNonce               Bytes
  recoveryEncryptedPrivateKey Bytes
  recoveryCodeHash            String
  version                     Int      @default(1)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountArchiveMessage {
  ownerUserId        String
  logicalMessageId   String
  conversationId     String
  senderUserId       String
  senderDeviceId     String
  ephemeralPublicKey Bytes
  nonce              Bytes
  ciphertext         Bytes
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner        User         @relation("ArchiveOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  sender       User         @relation("ArchiveSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([ownerUserId, logicalMessageId])
  @@index([ownerUserId, createdAt, logicalMessageId])
  @@index([conversationId, ownerUserId, createdAt])
}

model OneTimePreKey {
  id        String @id @default(uuid())
  deviceId  String
  keyId     Int
  publicKey Bytes

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
}

model Conversation {
  id   String           @id @default(uuid())
  type ConversationType

  directKey         String? @unique
  initiatedByUserId String?
  /// Display label for a GROUP. Not message contents.
  title             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Next MLS epoch the delivery service will accept. Public framing only.
  mlsEpoch Int @default(0)

  members         ConversationMember[]
  messages        Message[]
  messageDeletions MessageDeletion[]
  archiveMessages AccountArchiveMessage[]
  media           MediaObject[]
  groupMlsBlobs   GroupMlsBlob[]
  groupCommits    GroupMlsCommit[]
}

/// Opaque MLS (RFC 9420) wire bytes for a small group.
/// payload is ciphertext or a public key package. Never store plaintext here.
model GroupMlsBlob {
  id                String   @id @default(uuid())
  conversationId    String
  senderDeviceId    String
  kind              String
  recipientDeviceId String?
  payload           Bytes
  bindingSignature  Bytes?
  /// Client idempotency key. A retry of the same upload returns the original row.
  clientId          String?
  /// Public epoch from a private message. Null for key packages and welcomes.
  epoch             Int?
  createdAt         DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderDevice    Device       @relation("GroupMlsBlobSender", fields: [senderDeviceId], references: [id])
  recipientDevice Device?      @relation("GroupMlsBlobRecipient", fields: [recipientDeviceId], references: [id], onDelete: SetNull)
  commit          GroupMlsCommit?

  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt])
}

/// One accepted commit per epoch. A second commit for the same epoch is a fork.
model GroupMlsCommit {
  conversationId String
  epoch          Int
  blobId         String   @unique
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  blob         GroupMlsBlob @relation(fields: [blobId], references: [id], onDelete: Cascade)

  @@id([conversationId, epoch])
}

model ConversationMember {
  conversationId String
  userId         String
  /// Used by GROUP conversations. DIRECT membership ignores it.
  role           GroupMemberRole @default(MEMBER)
  /// Latest group blob this member has opened. Unread counts use it. Not message contents.
  groupReadBlobId String?

  joinedAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model MediaObject {
  id             String   @id @default(uuid())
  conversationId String
  uploaderUserId String
  objectKey      String   @unique
  byteSize       Int
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Message {
  id               String  @id @default(uuid())
  logicalMessageId String?

  conversationId    String
  senderDeviceId    String
  recipientDeviceId String?

  ciphertext    Bytes
  nonce         Bytes
  ratchetHeader Json

  createdAt DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderDevice    Device       @relation(fields: [senderDeviceId], references: [id])
  recipientDevice Device?      @relation("MessageRecipientDevice", fields: [recipientDeviceId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([recipientDeviceId, createdAt])
  @@index([logicalMessageId])
}

model MessageDeletion {
  conversationId   String
  logicalMessageId String
  deletedByUserId  String
  messageRecordIds String[] @default([])
  deletedAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deletedBy    User         @relation("MessageDeletionActor", fields: [deletedByUserId], references: [id], onDelete: Cascade)

  @@id([conversationId, logicalMessageId])
  @@index([conversationId, deletedAt, logicalMessageId])
}

model Project {
  id           String   @id @default(uuid())
  ownerUserId  String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([ownerUserId, updatedAt])
}

model Task {
  id              String     @id @default(uuid())
  ownerUserId     String
  projectId       String?
  title           String
  dueAt           DateTime?
  status          TaskStatus @default(OPEN)
  source          TaskSource @default(MANUAL)
  clientDraftId   String?
  conversationId  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  owner     User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@unique([ownerUserId, clientDraftId])
  @@index([ownerUserId, status, updatedAt])
  @@index([ownerUserId, dueAt])
}

model Reminder {
  id          String         @id @default(uuid())
  ownerUserId String
  taskId      String?
  remindAt    DateTime
  status      ReminderStatus @default(SCHEDULED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  owner User  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, remindAt])
  @@index([ownerUserId, status])
}

/// Explicit cloud-Sophia grant. Off until the person checks the purpose.
/// Withdraw sets withdrawnAt; that clears the grant and stops cloud calls.
/// The row stays so the person can see who agreed, when, the purpose, and the version.
model CloudSophiaConsent {
  id          String    @id @default(uuid())
  userId      String
  purposeText String
  versionId   String
  grantedAt   DateTime  @default(now())
  withdrawnAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, grantedAt])
  @@index([userId, withdrawnAt])
}

/// Append-only account activity the owner can read, export, or erase in full.
/// No per-event update route. Summaries are short metadata, never bodies or tokens.
model AccountActivityEvent {
  id          String                @id @default(uuid())
  ownerUserId String
  actorUserId String
  actorLabel  String
  action      AccountActivityAction
  summary     String
  subjectKind String?
  subjectId   String?
  occurredAt  DateTime              @default(now())

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, occurredAt])
}

model AiAuthorizationConsent {
  id               String         @id @default(uuid())
  userId           String
  scope            AiConsentScope
  conversationId   String?
  grantedAt        DateTime       @default(now())
  revokedAt        DateTime?
  evidenceVersion  Int            @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope, revokedAt])
}

/// Per-user OAuth connection. Refresh tokens are encrypted at rest.
/// Never store chat plaintext here. Calendar/email bodies are not used for AI
/// unless a separate AiAuthorizationConsent is granted later.
model IntegrationConnection {
  id                    String                       @id @default(uuid())
  ownerUserId           String
  provider              IntegrationProvider
  accountEmail          String?
  scopes                String[]                     @default([])
  refreshTokenEncrypted String
  accessTokenEncrypted  String?
  accessTokenExpiresAt  DateTime?
  status                IntegrationConnectionStatus  @default(CONNECTED)
  lastSyncAt            DateTime?
  lastErrorCode         String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  owner          User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  calendarEvents CalendarEventMirror[]
  mailMessages   MailMessageMirror[]
  workItems      WorkItemMirror[]
  collabChannels CollabChannelMirror[]

  @@unique([ownerUserId, provider])
  @@index([ownerUserId, status])
}

/// Owner-scoped calendar mirror for UI sync. Titles/times are the user's own
/// calendar metadata (not E2EE chat). Do not feed into AI without consent.
model CalendarEventMirror {
  id              String   @id @default(uuid())
  ownerUserId     String
  connectionId    String
  externalEventId String
  calendarId      String
  title           String
  startsAt        DateTime
  endsAt          DateTime
  allDay          Boolean  @default(false)
  busy            Boolean  @default(true)
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner      User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalEventId])
  @@index([ownerUserId, startsAt, endsAt])
  @@index([ownerUserId, syncedAt])
}

/// Owner-scoped mail metadata mirror. Subject/from/snippet only — never full
/// bodies for AI unless a separate AiAuthorizationConsent is granted later.
model MailMessageMirror {
  id                String   @id @default(uuid())
  ownerUserId       String
  connectionId      String
  externalMessageId String
  threadId          String
  subject           String
  fromAddress       String
  receivedAt        DateTime
  snippet           String   @default("")
  syncedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner      User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalMessageId])
  @@index([ownerUserId, receivedAt])
  @@index([ownerUserId, syncedAt])
}

/// Owner-scoped GitHub/Linear work-item mirror. Title/state/url metadata only —
/// never issue bodies, comments, or chat plaintext. Not for AI without consent.
model WorkItemMirror {
  id                 String       @id @default(uuid())
  ownerUserId        String
  connectionId       String
  externalItemId     String
  kind               WorkItemKind
  number             Int?
  title              String
  state              String
  url                String
  containerKey       String       @default("")
  updatedAtExternal  DateTime?
  syncedAt           DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  owner      User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalItemId])
  @@index([ownerUserId, syncedAt])
  @@index([ownerUserId, updatedAtExternal])
}

/// Owner-scoped Slack channel mirror. Names/ids only — never message plaintext
/// or chat E2EE content. Not for AI without a separate consent.
model CollabChannelMirror {
  id                 String   @id @default(uuid())
  ownerUserId        String
  connectionId       String
  externalChannelId  String
  name               String
  isPrivate          Boolean  @default(false)
  isArchived         Boolean  @default(false)
  syncedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner      User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalChannelId])
  @@index([ownerUserId, syncedAt])
}

/// One explicit approval of a mail or calendar write.
/// The provider is called only after status moves pending → executing, and a
/// second approval of the same row never calls it again. Payload bytes are not
/// stored; only a hash, so the approve request must resend the exact proposal.
model IntegrationWriteApproval {
  id             String                 @id @default(uuid())
  ownerUserId    String
  idempotencyKey String
  action         IntegrationWriteAction
  provider       String
  payloadHash    String
  status         IntegrationWriteStatus @default(PENDING)
  externalId     String?
  htmlLink       String?
  errorCode      String?
  errorMessage   String?
  errorStatus    Int?
  expiresAt      DateTime
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, idempotencyKey])
  @@index([ownerUserId, createdAt])
}

/// When Sophia should prepare the manager brief. Times are local to timeZone.
/// This row does not store mail, calendar, or chat text.
model DailyBriefPreference {
  userId    String   @id
  briefTime String   @default("07:00")
  language  String   @default("en")
  timeZone  String   @default("Asia/Amman")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One prepared brief for a local calendar day.
/// `document` holds meeting titles, mail subjects, and unsent action drafts
/// from integrations the owner connected. It must not contain E2EE chat.
/// Do not log `document`; the process logger redacts brief fields.
model DailyBrief {
  id          String   @id @default(uuid())
  ownerUserId String
  localDate   String
  language    String
  timeZone    String
  source      String
  mode        String
  document    Json
  generatedAt DateTime @default(now())

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, localDate])
  @@index([ownerUserId, generatedAt])
}

enum WorkspaceKind {
  FAMILY
  TEAM
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

/// A family or team that can find each other and open E2EE chats.
/// Membership and invite metadata only. Chat plaintext is never stored here.
model Workspace {
  id        String        @id @default(uuid())
  name      String
  kind      WorkspaceKind
  /// Plan id from the server catalog (FREE_FAMILY, FAMILY_PLUS, TEAM).
  planId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  members WorkspaceMember[]
  invites WorkspaceInvite[]
  billing WorkspaceBilling?

  @@index([kind, createdAt])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

/// Single-use invite. Only the hash of the code is stored.
/// codeHint is the last four characters so an admin can tell invites apart.
model WorkspaceInvite {
  id               String    @id @default(uuid())
  workspaceId      String
  createdByUserId  String
  codeHash         String    @unique
  codeHint         String
  expiresAt        DateTime
  consumedAt       DateTime?
  consumedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  consumedBy User?     @relation("InviteRedeemer", fields: [consumedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([createdByUserId, createdAt])
}

/// Billing status for a workspace. No card numbers or payment payloads.
/// status: comped (design partner, no charge), incomplete (checkout not finished),
/// active (paid or mock-confirmed), canceled.
model WorkspaceBilling {
  workspaceId            String   @id
  provider               String   @default("none")
  status                 String   @default("comped")
  externalCustomerId     String?
  externalSubscriptionId String?
  seatQuantity           Int      @default(1)
  updatedAt              DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Public "Join as design partner" waitlist. Email only, no account required.
model DesignPartnerRequest {
  id        String   @id @default(uuid())
  email     String
  locale    String   @default("en")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
