generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum TaskStatus {
  OPEN
  DONE
  DISMISSED
}

enum TaskSource {
  MANUAL
  RADAR
}

enum ReminderStatus {
  SCHEDULED
  CANCELLED
  FIRED
}

enum AiConsentScope {
  CLOUD_AI
  CONVERSATION_ANALYSIS
}

enum IntegrationProvider {
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
  GMAIL
  OUTLOOK_MAIL
  GITHUB
  LINEAR
}

enum WorkItemKind {
  ISSUE
  PULL_REQUEST
}

enum IntegrationConnectionStatus {
  CONNECTED
  REVOKED
  ERROR
}

model User {
  id                 String    @id @default(uuid())
  username           String    @unique
  email              String    @unique
  passwordHash       String
  totpSecret         String?
  pendingTotpSecret  String?
  totpSetupExpiresAt DateTime?
  vaultVersion       Int       @default(1)

  displayName String?
  avatarUrl   String?
  interests   String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices              Device[]
  memberships          ConversationMember[]
  authSessions         AuthSession[]
  trustedBrowsers      TrustedBrowser[]
  authTokens           AuthToken[]
  recoveryCodes        RecoveryCode[]
  archiveKey           AccountArchiveKey?
  archiveMessages      AccountArchiveMessage[] @relation("ArchiveOwner")
  archivedSentMessages AccountArchiveMessage[] @relation("ArchiveSender")
  messageDeletions     MessageDeletion[]        @relation("MessageDeletionActor")
  projects             Project[]
  tasks                Task[]
  reminders            Reminder[]
  aiConsents           AiAuthorizationConsent[]
  integrations         IntegrationConnection[]
  calendarEvents       CalendarEventMirror[]
  mailMessages         MailMessageMirror[]
  workItems            WorkItemMirror[]

  @@index([interests], type: Gin)
}

model TrustedBrowser {
  id            String   @id @default(uuid())
  userId        String
  tokenHash     String   @unique
  networkPrefix String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthSession {
  id        String    @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model AuthToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Device {
  id         String @id @default(uuid())
  userId     String
  deviceName String

  identityPublicKey Bytes
  signingPublicKey  Bytes

  signedPreKeyId  Int
  signedPreKey    Bytes
  signedPreKeySig Bytes

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  oneTimePreKeys   OneTimePreKey[]
  sentMessages     Message[]
  receivedMessages Message[]       @relation("MessageRecipientDevice")
  backups          DeviceBackup[]

  @@index([userId])
}

model DeviceBackup {
  deviceId       String
  kind           String
  recordId       String
  conversationId String?
  payload        Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, kind, recordId])
  @@index([deviceId, kind, recordId])
  @@index([deviceId, kind, conversationId])
}

model AccountArchiveKey {
  userId                      String   @id
  publicKey                   Bytes
  passwordSalt                Bytes
  passwordNonce               Bytes
  passwordEncryptedPrivateKey Bytes
  recoverySalt                Bytes
  recoveryNonce               Bytes
  recoveryEncryptedPrivateKey Bytes
  recoveryCodeHash            String
  version                     Int      @default(1)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountArchiveMessage {
  ownerUserId        String
  logicalMessageId   String
  conversationId     String
  senderUserId       String
  senderDeviceId     String
  ephemeralPublicKey Bytes
  nonce              Bytes
  ciphertext         Bytes
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner        User         @relation("ArchiveOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  sender       User         @relation("ArchiveSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([ownerUserId, logicalMessageId])
  @@index([ownerUserId, createdAt, logicalMessageId])
  @@index([conversationId, ownerUserId, createdAt])
}

model OneTimePreKey {
  id        String @id @default(uuid())
  deviceId  String
  keyId     Int
  publicKey Bytes

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
}

model Conversation {
  id   String           @id @default(uuid())
  type ConversationType

  directKey         String? @unique
  initiatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         ConversationMember[]
  messages        Message[]
  messageDeletions MessageDeletion[]
  archiveMessages AccountArchiveMessage[]
  media           MediaObject[]
}

model ConversationMember {
  conversationId String
  userId         String

  joinedAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model MediaObject {
  id             String   @id @default(uuid())
  conversationId String
  uploaderUserId String
  objectKey      String   @unique
  byteSize       Int
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Message {
  id               String  @id @default(uuid())
  logicalMessageId String?

  conversationId    String
  senderDeviceId    String
  recipientDeviceId String?

  ciphertext    Bytes
  nonce         Bytes
  ratchetHeader Json

  createdAt DateTime @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderDevice    Device       @relation(fields: [senderDeviceId], references: [id])
  recipientDevice Device?      @relation("MessageRecipientDevice", fields: [recipientDeviceId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([recipientDeviceId, createdAt])
  @@index([logicalMessageId])
}

model MessageDeletion {
  conversationId   String
  logicalMessageId String
  deletedByUserId  String
  messageRecordIds String[] @default([])
  deletedAt        DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  deletedBy    User         @relation("MessageDeletionActor", fields: [deletedByUserId], references: [id], onDelete: Cascade)

  @@id([conversationId, logicalMessageId])
  @@index([conversationId, deletedAt, logicalMessageId])
}

model Project {
  id           String   @id @default(uuid())
  ownerUserId  String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([ownerUserId, updatedAt])
}

model Task {
  id              String     @id @default(uuid())
  ownerUserId     String
  projectId       String?
  title           String
  dueAt           DateTime?
  status          TaskStatus @default(OPEN)
  source          TaskSource @default(MANUAL)
  clientDraftId   String?
  conversationId  String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  owner     User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@unique([ownerUserId, clientDraftId])
  @@index([ownerUserId, status, updatedAt])
  @@index([ownerUserId, dueAt])
}

model Reminder {
  id          String         @id @default(uuid())
  ownerUserId String
  taskId      String?
  remindAt    DateTime
  status      ReminderStatus @default(SCHEDULED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  owner User  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, remindAt])
  @@index([ownerUserId, status])
}

model AiAuthorizationConsent {
  id               String         @id @default(uuid())
  userId           String
  scope            AiConsentScope
  conversationId   String?
  grantedAt        DateTime       @default(now())
  revokedAt        DateTime?
  evidenceVersion  Int            @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scope, revokedAt])
}

/// Per-user OAuth connection. Refresh tokens are encrypted at rest.
/// Never store chat plaintext here. Calendar/email bodies are not used for AI
/// unless a separate AiAuthorizationConsent is granted later.
model IntegrationConnection {
  id                    String                       @id @default(uuid())
  ownerUserId           String
  provider              IntegrationProvider
  accountEmail          String?
  scopes                String[]                     @default([])
  refreshTokenEncrypted String
  accessTokenEncrypted  String?
  accessTokenExpiresAt  DateTime?
  status                IntegrationConnectionStatus  @default(CONNECTED)
  lastSyncAt            DateTime?
  lastErrorCode         String?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  owner          User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  calendarEvents CalendarEventMirror[]
  mailMessages   MailMessageMirror[]
  workItems      WorkItemMirror[]

  @@unique([ownerUserId, provider])
  @@index([ownerUserId, status])
}

/// Owner-scoped calendar mirror for UI sync. Titles/times are the user's own
/// calendar metadata (not E2EE chat). Do not feed into AI without consent.
model CalendarEventMirror {
  id              String   @id @default(uuid())
  ownerUserId     String
  connectionId    String
  externalEventId String
  calendarId      String
  title           String
  startsAt        DateTime
  endsAt          DateTime
  allDay          Boolean  @default(false)
  busy            Boolean  @default(true)
  syncedAt        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner      User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalEventId])
  @@index([ownerUserId, startsAt, endsAt])
  @@index([ownerUserId, syncedAt])
}

/// Owner-scoped mail metadata mirror. Subject/from/snippet only — never full
/// bodies for AI unless a separate AiAuthorizationConsent is granted later.
model MailMessageMirror {
  id                String   @id @default(uuid())
  ownerUserId       String
  connectionId      String
  externalMessageId String
  threadId          String
  subject           String
  fromAddress       String
  receivedAt        DateTime
  snippet           String   @default("")
  syncedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  owner      User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalMessageId])
  @@index([ownerUserId, receivedAt])
  @@index([ownerUserId, syncedAt])
}

/// Owner-scoped GitHub/Linear work-item mirror. Title/state/url metadata only —
/// never issue bodies, comments, or chat plaintext. Not for AI without consent.
model WorkItemMirror {
  id                 String       @id @default(uuid())
  ownerUserId        String
  connectionId       String
  externalItemId     String
  kind               WorkItemKind
  number             Int?
  title              String
  state              String
  url                String
  containerKey       String       @default("")
  updatedAtExternal  DateTime?
  syncedAt           DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  owner      User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalItemId])
  @@index([ownerUserId, syncedAt])
  @@index([ownerUserId, updatedAtExternal])
}
