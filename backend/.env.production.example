# Production-oriented backend env template (copy to backend/.env on the VM).
# OAuth / TURN / optional keys load via compose `env_file`.
# Compose-interpolated secrets (JWT_SECRET, TOTP_ENCRYPTION_KEY, FRONTEND_ORIGIN)
# must ALSO live in the repo-root `.env` — see ../.env.example.

DATABASE_URL="postgresql://messenger:messenger@postgres:5432/messenger"
REDIS_URL="redis://redis:6379"
JWT_SECRET="replace-with-at-least-32-random-characters"
TOTP_ENCRYPTION_KEY="replace-with-64-hex-characters"
PORT=3001
FRONTEND_ORIGIN="https://sophia.apps.grok.bot"
COOKIE_NAME="messenger_session"
# docker-compose.prod.yml forces COOKIE_SECURE=true in the container.
COOKIE_SECURE=true
API_PUBLIC_ORIGIN="https://api.sophia-build.com"
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
MICROSOFT_MAIL_CLIENT_ID=
MICROSOFT_MAIL_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
BRAVE_SEARCH_API_KEY=
SAFE_BROWSING_API_KEY=
TURN_URLS=
TURN_SHARED_SECRET=
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
